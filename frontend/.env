# Safe local defaults committed for every Baldin worktree.
# Put real secrets and user-specific overrides in frontend/.env.local
# or process environment variables.
VITE_API_URL=http://localhost:8004

# Sentry error monitoring (baldin-ui project).
# Leave blank to disable during local development.
VITE_SENTRY_DSN=
# Environment tag sent to Sentry (DEV | STAGE | PROD).
VITE_SENTRY_ENVIRONMENT=DEV
# Fraction of page-loads traced for performance monitoring (0 - 1).
VITE_SENTRY_TRACES_SAMPLE_RATE=0

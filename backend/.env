# Safe local defaults committed for every Baldin worktree.
# Put real secrets and user-specific overrides in backend/.env.local
# or process environment variables.
SECRET_KEY=DVnFmhwvjEhJZpuhndxjhlezxQPJmBIIkMDEmFREWQADPcUnrG
MFA_ENCRYPTION_KEY=
ENVIRONMENT=DEV
ACCESS_TOKEN_EXPIRE_MINUTES=11520
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8004
MAX_CONCURRENCY=8
MAX_CHUNKS=-1
LOGGING_LEVEL=DEBUG


DEFAULT_DATABASE_HOSTNAME=db
DEFAULT_DATABASE_USER=postgres
DEFAULT_DATABASE_PASSWORD=postgres
DEFAULT_DATABASE_PORT=5432
DEFAULT_DATABASE_DB=db


TEST_DATABASE_HOSTNAME=test_db
TEST_DATABASE_USER=postgres
TEST_DATABASE_PASSWORD=postgres
TEST_DATABASE_PORT=5431
TEST_DATABASE_DB=test_db
FIRST_SUPERUSER_EMAIL=admin@baldin.app
FIRST_SUPERUSER_PASSWORD=Admin1Pass


LINKEDIN_USERNAME=""
LINKEDIN_PASSWORD=""
GLASSDOOR_USERNAME=""
GLASSDOOR_PASSWORD=""
# Required for document embedding, semantic search, and RAG endpoints.
# Obtain a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Sentry error monitoring (baldin-api project).
# Leave blank to disable. Obtain a DSN at https://sentry.io
SENTRY_DSN=
# Fraction of requests traced for performance monitoring (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# Crawler worker settings
# Set REDIS_URL to enable worker mode (e.g. redis://localhost:6379/0).
# Leave blank to fall back to inline execution inside the API process.
REDIS_URL=redis://redis:6379/0
CRAWLER_QUEUE_NAME=crawler_jobs
# Set to "worker" when the crawler-worker service is running; otherwise "inline".
CRAWLER_EXECUTION_MODE=inline
# How often (in seconds) the scheduler checks for pending crawler runs.
CRAWLER_SCHEDULER_INTERVAL=60

# Internal ETL service settings
ETL_SERVICE_URL=http://etl-service:8010
ETL_SERVICE_TIMEOUT_SECONDS=180
